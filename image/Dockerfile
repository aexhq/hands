# The Hand image for **plain Docker** (standalone Brain, dev box, CI smoke). The guest binary is compiled
# separately (aarch64-unknown-linux-gnu, glibc, matching the ubuntu base) and copied in, so this
# stays a thin, cached runtime layer. The production Lambda MicroVM image is generated by
# `hand-lambda` (crates/hand-lambda/src/image.rs), not from this file — the two share the same
# toolchain but the Lambda image adds a root boot script (DNS pin + swap) and drops privileges.
#
#   docker build -f image/Dockerfile --build-arg BIN=target/aarch64-unknown-linux-gnu/release/hand-guest -t hand:dev .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    HOME=/home/agent \
    CARGO_HOME=/workspace/.hand/cargo \
    RUSTUP_HOME=/workspace/.hand/rustup \
    GOPATH=/workspace/.hand/go \
    GOMODCACHE=/workspace/.hand/go/pkg/mod \
    npm_config_prefix=/workspace/.hand/npm \
    PIP_CACHE_DIR=/workspace/.hand/pip \
    PIPX_HOME=/workspace/.hand/pipx \
    PIPX_BIN_DIR=/workspace/.hand/bin \
    UV_CACHE_DIR=/workspace/.hand/uv \
    PATH=/workspace/.hand/bin:/workspace/.hand/npm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HAND_WORKSPACE=/workspace \
    HAND_HOME=/home/agent \
    HAND_SPILL_DIR=/var/hand/ops \
    HAND_TOOL_DIR=/var/hand/tools \
    HAND_TOOL_RUNNER=/usr/local/lib/hand/tool-runner.mjs \
    HAND_LISTEN=0.0.0.0:8080

# Curated toolchain. Installers are redirected into /workspace/.hand/** (see ENV above) so their
# output is captured by workspace sync; system-wide installs are ephemeral and the agent is told so.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git openssh-client \
      build-essential pkg-config \
      python3 python3-venv python3-pip pipx \
      ripgrep jq unzip zip zstd xz-utils file less \
      procps coreutils bash \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg --print-architecture)" in \
         arm64) node_arch=arm64; node_sha=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8 ;; \
         amd64) node_arch=x64; node_sha=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307 ;; \
         *) echo "unsupported Node architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --retry 5 \
         --output /tmp/node.tar.xz \
         "https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-${node_arch}.tar.xz" \
    && echo "${node_sha}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar --extract --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && test "$(node --version)" = v22.23.2 \
    && npm --version

# ubuntu:24.04 ships a uid-1000 "ubuntu" user; remove it, then create "agent" as uid 1000.
RUN deluser --remove-home ubuntu 2>/dev/null || true; \
    userdel -f ubuntu 2>/dev/null || true; \
    groupdel ubuntu 2>/dev/null || true; \
    useradd --create-home --home-dir /home/agent --shell /bin/bash --uid 1000 --user-group agent \
    && mkdir -p /workspace /var/hand/ops /var/hand/tools /usr/local/lib/hand \
    && chown -R agent:agent /workspace /home/agent /var/hand

ARG BIN
COPY ${BIN} /usr/local/bin/hand-guest
COPY image/tool-runner.mjs /usr/local/lib/hand/tool-runner.mjs
RUN chmod 0755 /usr/local/bin/hand-guest

USER agent
WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/hand-guest"]
