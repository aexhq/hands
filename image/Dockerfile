# The Hand image for **plain Docker** (local development and CI smoke). The guest binary is compiled
# separately (aarch64-unknown-linux-gnu, glibc, matching the ubuntu base) and copied in, so this
# stays a thin, cached runtime layer. The production Lambda MicroVM image is generated by
# `hand-lambda` (crates/hand-lambda/src/image.rs), not from this file — the two share the same
# toolchain but the Lambda image adds a root boot script (DNS pin + swap).
#
#   docker build -f image/Dockerfile --build-arg BIN=target/aarch64-unknown-linux-gnu/release/hand-guest -t hand:dev .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    HOME=/home/agent \
    CARGO_HOME=/workspace/.hand/cargo \
    RUSTUP_HOME=/workspace/.hand/rustup \
    GOPATH=/workspace/.hand/go \
    GOMODCACHE=/workspace/.hand/go/pkg/mod \
    npm_config_prefix=/workspace/.hand/npm \
    PIP_CACHE_DIR=/workspace/.hand/pip \
    PIPX_HOME=/workspace/.hand/pipx \
    PIPX_BIN_DIR=/workspace/.hand/bin \
    UV_CACHE_DIR=/workspace/.hand/uv \
    PATH=/workspace/.hand/bin:/workspace/.hand/npm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HAND_WORKSPACE=/workspace \
    HAND_TOOL_DIR=/var/hand/tools \
    HAND_TOOL_RUNNER=/usr/local/lib/hand/tool-runner.mjs \
    HAND_TOOL_BOUNDARY_LIBRARY=/usr/local/lib/hand/tool-boundary.so \
    HAND_SUPERVISOR_UID=1001 \
    HAND_TOOL_UID=1000 \
    HAND_TOOL_GID=1000 \
    HAND_LISTEN=0.0.0.0:8080

# Curated toolchain. Installers are redirected into /workspace/.hand/** (see ENV above) so their
# output stays in the live workspace generation; no automatic checkpoint or restore exists.
# Node 22.23.2 bundles npm with node-tar 7.5.11 (CVE-2026-59873), so replace that bundled
# installation in place; leaving it beside a newer npm would leave vulnerable files in the image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git openssh-client \
      build-essential pkg-config \
      python3 python3-venv python3-pip pipx \
      ripgrep jq unzip zip zstd xz-utils file less \
      procps coreutils bash libcap2-bin util-linux iproute2 nftables \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg --print-architecture)" in \
         arm64) node_arch=arm64; node_sha=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8 ;; \
         amd64) node_arch=x64; node_sha=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307 ;; \
         *) echo "unsupported Node architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --retry 5 \
         --output /tmp/node.tar.xz \
         "https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-${node_arch}.tar.xz" \
    && echo "${node_sha}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar --extract --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && test "$(node --version)" = v22.23.2 \
    && npm_config_prefix=/usr/local npm install --global npm@11.19.0 \
    && test "$(npm --version)" = 11.19.0

# ubuntu:24.04 ships a uid-1000 "ubuntu" user; remove it, then create "agent" as uid 1000.
RUN deluser --remove-home ubuntu 2>/dev/null || true; \
    userdel -f ubuntu 2>/dev/null || true; \
    groupdel ubuntu 2>/dev/null || true; \
    useradd --create-home --home-dir /home/agent --shell /bin/bash --uid 1000 --user-group agent \
    && groupadd --gid 1001 hand \
    && useradd --uid 1001 --gid hand --groups agent --no-create-home --home-dir /nonexistent hand \
    && mkdir -p /workspace /var/hand/ops /var/hand/bindings /var/hand/objects /var/hand/file-staging /var/hand/tools /usr/local/lib/hand \
    && chown -R agent:agent /workspace /home/agent \
    && chmod 2770 /workspace /home/agent \
    && chown -R hand:hand /var/hand/ops /var/hand/bindings /var/hand/objects \
    && chmod 0700 /var/hand/ops /var/hand/bindings /var/hand/objects \
    && chown -R hand:agent /var/hand/file-staging \
    && chmod 2700 /var/hand/file-staging \
    && chown -R hand:agent /var/hand/tools \
    && chmod 2750 /var/hand/tools \
    && test "$(stat -c '%d:%g' /workspace)" = "$(stat -c '%d:%g' /var/hand/file-staging)" \
    && test "$(stat -c '%a' /var/hand/file-staging)" = 2700

# Curated Tool code needs no package-owned privilege transition. Strip the entire distro/toolchain
# setuid, setgid and file-capability surface before adding back the one narrowly scoped supervisor
# executable below; CI scans the completed image so a package update cannot silently reopen it.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
    && getcap -r /usr /bin /sbin /usr/local 2>/dev/null \
         | awk '{print $1}' | sort -u | xargs -r -n1 setcap -r

ARG BIN
COPY ${BIN} /usr/local/bin/hand-guest
COPY image/tool-runner.mjs /usr/local/lib/hand/tool-runner.mjs
COPY image/tool-boundary.c /tmp/tool-boundary.c
COPY image/proc-secret-static.c /tmp/proc-secret-static.c
COPY image/hand-boot.sh /usr/local/bin/hand-boot.sh
RUN chown root:hand /usr/local/bin/hand-guest \
    && chmod 0750 /usr/local/bin/hand-guest \
    && chmod 0755 /usr/local/bin/hand-boot.sh \
    && cc -shared -fPIC -O2 -Wl,-z,relro,-z,now \
         -o /usr/local/lib/hand/tool-boundary.so /tmp/tool-boundary.c \
    && cc -static -O2 -Wl,-z,relro,-z,now \
         -o /usr/local/lib/hand/proc-secret-static /tmp/proc-secret-static.c \
    && rm /tmp/tool-boundary.c /tmp/proc-secret-static.c \
    && chown root:root /usr/local/lib/hand/tool-boundary.so /usr/local/lib/hand/proc-secret-static \
    && chmod 0555 /usr/local/lib/hand/tool-boundary.so /usr/local/lib/hand/proc-secret-static \
    && setcap cap_kill,cap_setuid,cap_setgid=ep /usr/local/bin/hand-guest \
    && test "$(stat -c '%u:%g:%a' /usr/local/lib/hand/tool-boundary.so)" = "0:0:555" \
    && test "$(stat -c '%u:%g:%a' /usr/local/lib/hand/proc-secret-static)" = "0:0:555" \
    && ! readelf -l /usr/local/lib/hand/proc-secret-static | grep -q INTERP \
    && test -z "$(find / -xdev -type f -perm /6000 -print -quit)" \
    && test "$(getcap -r / 2>/dev/null)" = "/usr/local/bin/hand-guest cap_kill,cap_setgid,cap_setuid=ep"

WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/hand-boot.sh"]
